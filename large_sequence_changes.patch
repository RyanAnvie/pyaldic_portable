+    def tearDown(self):
+        self.ctrl.cancel_loading()
+        pump_until(lambda: not self.ctrl.is_loading)
+        for widget in self.widgets:
+            widget.close()
+            widget.deleteLater()
+        self.state.deleteLater()
+        self.app.sendPostedEvents(None, QEvent.Type.DeferredDelete)
+        self.app.processEvents()
+        self.temp.cleanup()
